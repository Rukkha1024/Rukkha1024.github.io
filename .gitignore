# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Keep the original working draft local; published content lives under _pages/.
resume.md

# Keep large lecture source material (PPTX) local; only optimized images ship.
*.pptx

# Keep private academic records and application CV artifacts local.
files/*성적증명서*.pdf
files/*재학증명서*.pdf
files/*졸업증명서*.pdf
files/*학위증명서*.pdf
files/*GPA*.pdf
files/*gpa*.pdf
